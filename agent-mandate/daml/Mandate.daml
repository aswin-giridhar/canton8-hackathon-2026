-- Starter for the mandate task (D3 direct debit / D4 agent wallet).
--
-- One party lets another spend up to a cap, until a deadline, and can revoke
-- at any time. Same contract either way: for D3 the spender is a merchant,
-- for D4 it is an AI agent.
--
-- The point of the task: the cap is enforced HERE, in Daml. Not in your API.
-- A cap checked in Python is a suggestion. A cap in a choice body is a rule.
--
-- What to build on top:
--   * move real value: make Charge exercise a token transfer, not just record it
--   * an allow-list of counterparties the spender may pay
--   * per-period reset (harder than it looks, do the total cap first)
--   * an audit view of every charge
module Mandate where

import Value
import Splice.Api.Token.TransferInstructionV1

-- ONE gate, used by every charge path. Two paths with two copies of the rules
-- is how guards drift apart; this is the whole point of the project, so it
-- lives in exactly one place.
validateCharge : Party -> [Party] -> Decimal -> Decimal -> Time
              -> Decimal -> Party -> Time -> Update ()
validateCharge owner allowed cap spent expiresAt amount receiver now = do
  assertMsg "mandate expired" (now < expiresAt)
  assertMsg "amount must be positive" (amount > 0.0)
  assertMsg "charge would exceed the cap" (spent + amount <= cap)
  assertMsg "counterparty is not on the allow-list" (receiver `elem` allowed)


template Mandate
  with
    owner    : Party      -- who is paying
    spender  : Party      -- merchant, or agent
    cap      : Decimal    -- total they may spend over the mandate's life
    spent    : Decimal    -- how much so far
    allowedCounterparties : [Party]  -- who the spender may pay
    expiresAt : Time
  where
    ensure cap > 0.0 && spent >= 0.0 && spent <= cap

    -- Both must agree it exists. The owner cannot be signed up without
    -- consenting, and the spender cannot be bound without consenting.
    signatory owner, spender

    -- Spend within the mandate. No owner signature needed, that is the point.
    choice Charge : ContractId Mandate
      with
        amount : Decimal
        receiver : Party
        -- Optional so there is ONE charge path, not two. Two paths would need
        -- the same guards in both places, and that is how guards diverge.
        purse : Optional (ContractId Purse)
      controller spender
      do
        now <- getTime
        validateCharge owner allowedCounterparties cap spent expiresAt
                       amount receiver now

        -- Every charge leaves a record naming which rule permitted it. Written
        -- in the same transaction as the spend, so a charge without an audit
        -- entry is not a state the ledger can reach.
        create ChargeRecord with
          owner; spender; receiver; amount
          spentAfter = spent + amount
          cap
          permittedBy =
            "within cap (" <> show (spent + amount) <> " of " <> show cap
              <> ") and counterparty on the allow-list"
          chargedAt = now

        -- THE CLAIM UNDER TEST: this exercise needs the OWNER's authority
        -- (Debit is `controller owner`), and the agent submitting alone does
        -- not have it. It succeeds only because a choice body carries the
        -- authority of the CONTRACT's signatories -- and Alice is one.
        -- No hot key. No owner signature at spend time.
        case purse of
          None -> pure ()
          Some p -> do
            _ <- exercise p Debit with amt = amount
            pure ()

        create this with spent = spent + amount

    -- Move REAL value through the token standard.
    --
    -- The agent supplies the factory and the transfer it wants executed, both
    -- obtained off-ledger from the registry (privacy means the agent cannot
    -- see the issuer's config contracts; they arrive as disclosed contracts).
    --
    -- CRITICAL: every rule is checked against `transferArgs.transfer` -- the
    -- transfer that will actually execute -- not against separate parameters.
    -- Checking parameters would let a compromised agent satisfy the guards
    -- with one receiver and then move money to another.
    choice ChargeViaTokenStandard : (ContractId Mandate, TransferInstructionResult)
      with
        factoryCid   : ContractId TransferFactory
        transferArgs : TransferFactory_Transfer
      controller spender
      do
        let t = transferArgs.transfer
        now <- getTime
        -- The funds must be the OWNER's. Without this the agent could spend
        -- someone else's holdings under cover of this mandate.
        assertMsg "transfer sender must be the mandate owner" (t.sender == owner)
        validateCharge owner allowedCounterparties cap spent expiresAt
                       t.amount t.receiver now

        result <- exercise factoryCid transferArgs

        create ChargeRecord with
          owner; spender
          receiver = t.receiver
          amount = t.amount
          spentAfter = spent + t.amount
          cap
          permittedBy =
            "token standard transfer within cap (" <> show (spent + t.amount)
              <> " of " <> show cap <> ") to an allow-listed counterparty"
          chargedAt = now
        m <- create this with spent = spent + t.amount
        pure (m, result)

    -- The owner can always stop it, and the spender cannot block that.
    choice Revoke : ()
      controller owner
      do pure ()

    -- NARROWING IS UNILATERAL. The owner can always shrink what the agent may
    -- do, and the agent cannot block or delay it -- the same principle as
    -- Revoke, applied to scope rather than existence.
    --
    -- Without this, the only way to cut off one counterparty is to Revoke the
    -- whole mandate and re-propose, which the agent can stall by not accepting.
    -- Widening still requires both signatures, via Adjust.
    choice Restrict : ContractId Mandate
      with
        newCap     : Decimal
        newAllowed : [Party]
      controller owner
      do
        assertMsg "Restrict may only lower the cap; use Adjust to raise it"
          (newCap <= cap)
        assertMsg "cannot restrict the cap below what is already spent"
          (newCap >= spent)
        assertMsg "Restrict may only remove counterparties; use Adjust to add"
          (all (`elem` allowedCounterparties) newAllowed)
        create this with cap = newCap, allowedCounterparties = newAllowed

    -- Raising the cap needs both parties, because both are signatories.
    choice Adjust : ContractId Mandate
      with newCap : Decimal
      controller owner, spender
      do
        assertMsg "new cap below what is already spent" (newCap >= spent)
        create this with cap = newCap


-- The audit trail. One immutable record per charge, naming what the agent did
-- AND which rule permitted it -- the difference between a log and an audit trail.
--
-- Signed by both, so neither can rewrite history alone. Non-consuming to create
-- and never archived by any choice: records accumulate.
template ChargeRecord
  with
    owner       : Party
    spender     : Party
    receiver    : Party
    amount      : Decimal
    spentAfter  : Decimal   -- running total AFTER this charge
    cap         : Decimal   -- the cap in force at the time
    permittedBy : Text      -- the rule that allowed it, in words
    chargedAt   : Time
  where
    signatory owner, spender


-- Propose and accept: the most common shape in Daml.
-- You cannot force a contract on someone who has to sign it, and you are
-- rarely online at the same time. So you offer, and they accept later.
template MandateProposal
  with
    owner    : Party
    spender  : Party
    cap      : Decimal
    allowedCounterparties : [Party]
    expiresAt : Time
  where
    signatory owner
    observer spender

    choice Accept : ContractId Mandate
      controller spender
      do create Mandate with
           owner; spender; cap; spent = 0.0; allowedCounterparties; expiresAt

    choice Reject : ()
      controller spender
      do pure ()
